{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "dialog:default",
    "fs:default",
    "shell:allow-open",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {"path": "$HOME/**"},
        {"path": "$DOCUMENT/**"},
        {"path": "$DESKTOP/**"},
        {"path": "$DOWNLOAD/**"},
        {"path": "C:/**"},
        {"path": "D:/**"},
        {"path": "E:/**"}
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {"path": "$HOME/**"},
        {"path": "$DOCUMENT/**"},
        {"path": "$DESKTOP/**"},
        {"path": "$DOWNLOAD/**"},
        {"path": "C:/**"},
        {"path": "D:/**"},
        {"path": "E:/**"}
      ]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [
        {"path": "$HOME/**"},
        {"path": "$DOCUMENT/**"},
        {"path": "$DESKTOP/**"},
        {"path": "$DOWNLOAD/**"},
        {"path": "C:/**"},
        {"path": "D:/**"},
        {"path": "E:/**"}
      ]
    },
    {
      "identifier": "fs:allow-read",
      "allow": [
        {"path": "$HOME/**"},
        {"path": "$DOCUMENT/**"},
        {"path": "$DESKTOP/**"},
        {"path": "$DOWNLOAD/**"},
        {"path": "C:/**"},
        {"path": "D:/**"},
        {"path": "E:/**"}
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {"path": "$HOME/**"},
        {"path": "$DOCUMENT/**"},
        {"path": "$DESKTOP/**"},
        {"path": "$DOWNLOAD/**"},
        {"path": "C:/**"},
        {"path": "D:/**"},
        {"path": "E:/**"}
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {"path": "$HOME/**"},
        {"path": "$DOCUMENT/**"},
        {"path": "$DESKTOP/**"},
        {"path": "$DOWNLOAD/**"},
        {"path": "C:/**"},
        {"path": "D:/**"},
        {"path": "E:/**"}
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {"path": "$HOME/**"},
        {"path": "$DOCUMENT/**"},
        {"path": "$DESKTOP/**"},
        {"path": "$DOWNLOAD/**"},
        {"path": "C:/**"},
        {"path": "D:/**"},
        {"path": "E:/**"}
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {"path": "$HOME/**"},
        {"path": "$DOCUMENT/**"},
        {"path": "$DESKTOP/**"},
        {"path": "$DOWNLOAD/**"},
        {"path": "C:/**"},
        {"path": "D:/**"},
        {"path": "E:/**"}
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {"path": "$HOME/**"},
        {"path": "$DOCUMENT/**"},
        {"path": "$DESKTOP/**"},
        {"path": "$DOWNLOAD/**"},
        {"path": "C:/**"},
        {"path": "D:/**"},
        {"path": "E:/**"}
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        {"path": "$HOME/**"},
        {"path": "$DOCUMENT/**"},
        {"path": "$DESKTOP/**"},
        {"path": "$DOWNLOAD/**"},
        {"path": "C:/**"},
        {"path": "D:/**"},
        {"path": "E:/**"}
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {"path": "$HOME/**"},
        {"path": "$DOCUMENT/**"},
        {"path": "$DESKTOP/**"},
        {"path": "$DOWNLOAD/**"},
        {"path": "C:/**"},
        {"path": "D:/**"},
        {"path": "E:/**"}
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {"url": "https://amk.cn-beijing.volces.com/**"},
        {"url": "https://yunwu.ai/**"},
        {"url": "https://cunchutupian.tos-cn-beijing.volces.com/**"}
      ]
    }
  ]
}
