# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.cache

# Environment variables
.env
.env.local

# Dependencies (if accidentally installed at root)
node_modules/

# Build outputs (from any sub-project)
**/dist/
**/build/
**/.output/

# Database files
**/*.db
**/*.db-shm
**/*.db-wal

# Generated media files (limit to storage directories to avoid ignoring source assets)
**/storage/
**/data/storage/

# Coverage
**/coverage/
**/.nyc_output/

# Tauri
**/src-tauri/target/

# Electron
**/release/
**/dist-electron/

# App packages
*.exe
*.dmg
*.deb
*.rpm
*.snap
